# Chaingraph Configuration
# GraphQL endpoint for querying BCMR data from the Bitcoin Cash blockchain
# Example: http://your-chaingraph-server:8088/v1/graphql
CHAINGRAPH_URL=http://192.168.88.105:8088/v1/graphql

# Fulcrum Indexer Configuration
# WebSocket endpoint for Fulcrum Electrum server (authchain resolution)
# Example: ws://your-fulcrum-server:50003 or ws://your-fulcrum-server:80
FULCRUM_WS_URL=ws://192.168.88.17:80

# Fulcrum request timeout in milliseconds (Optional, default 30000)
# A request not answered within this time is rejected and its connection replaced
# FULCRUM_REQUEST_TIMEOUT_MS=30000

# Chaingraph request timeout in milliseconds (Optional, default 120000)
# Server-side authchain resolution of very long chains can take tens of seconds
# CHAINGRAPH_TIMEOUT_MS=120000

# Alternative BCMR v2 JSON schema for --fetch-valid-json (Optional)
# The schema is bundled with the tool; set this to validate against another
# copy. It is fetched once per run; on failure the bundled schema is used.
# BCMR_SCHEMA_URL=https://raw.githubusercontent.com/bitjson/chip-bcmr/master/bcmr-v2.schema.json

# Working Directory Configuration (Optional)
# Directory where all output files and folders will be saved
# If not set, files will be saved in the current working directory
# Example: /home/user/bcmr-data or ./data
# BCMR_WORKDIR=
